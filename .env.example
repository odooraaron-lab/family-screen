# ---- Addresses ----
# The product's own domain. Screens live at <name>.<SCREENS_DOMAIN>
APP_URL="https://resthome.myqr.co.nz"
SCREENS_DOMAIN="resthome.myqr.co.nz"
BRAND_NAME="myQR"
PRODUCT_NAME="Family Screen"
SUPPORT_EMAIL="hello@myqr.co.nz"

# ---- Database (can be the same Neon/Supabase database as the admin) ----
DATABASE_URL="postgres://user:pass@host/db?sslmode=require"

# ---- Stripe ----
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."        # this app's own webhook endpoint
STRIPE_PRICE_MONTHLY="price_..."
STRIPE_PRICE_YEARLY="price_..."
PRICE_MONTHLY_LABEL="$9 a month"
PRICE_YEARLY_LABEL="$79 a year"
TRIAL_DAYS="14"                           # set to 0 for no free trial

# ---- Photo and video storage (Vercel → Storage → Blob, then connect to this project) ----
BLOB_READ_WRITE_TOKEN=""

# ---- Email (resend.com) ----
RESEND_API_KEY=""
FROM_EMAIL="Family Screen <hello@myqr.co.nz>"

# ---- Admin connection (copy from the admin's Products → Resthome TV page) ----
HQ_URL="https://admin.myqr.co.nz"
HQ_PRODUCT="resthome"
HQ_SECRET=""

# ---- Cron ----
CRON_SECRET=""
